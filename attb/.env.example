# Environment Configuration Template
# Copy this file to .env and update values as needed

# Application Info
APP_NAME="Attendance Planner Backend"
APP_VERSION="1.0.0"
DEBUG=True

# CORS Settings (comma-separated origins)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Attendance Rules
MINIMUM_ATTENDANCE_THRESHOLD=75.0

# Server Configuration
HOST=0.0.0.0
PORT=8000

# Database (V2 - not yet implemented)
# DATABASE_URL=postgresql://user:password@localhost/attendance_db

# JWT Secret (V2 - not yet implemented)
# SECRET_KEY=your-secret-key-here
# ACCESS_TOKEN_EXPIRE_MINUTES=30

# Email Settings (Future)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-password
